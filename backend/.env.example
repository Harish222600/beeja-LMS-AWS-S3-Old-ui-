# ===========================================
# Beeja LMS Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your actual values
# Never commit the actual .env file to version control

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=5001
HOST=localhost
PUBLIC_IP=your_public_ip_here

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/lms
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/lms
MONGODB_URL=mongodb://localhost:27017/lms

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT Secret Key (use a strong, random string)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# ===========================================
# AWS S3 CONFIGURATION
# ===========================================
# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# S3 Bucket Configuration
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# CloudFront Distribution (optional, for CDN)
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.com

# S3 Auto-configuration (set to false to disable automatic bucket setup)
AUTO_CONFIGURE_S3=true

# ===========================================
# PAYMENT GATEWAY (RAZORPAY)
# ===========================================
# Razorpay Configuration
RAZORPAY_KEY=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_key_secret

# ===========================================
# EMAIL SERVICE CONFIGURATION
# ===========================================
# Email Service (Nodemailer)
# For Gmail: smtp.gmail.com
# For Outlook: smtp-mail.outlook.com
# For custom SMTP: your-smtp-server.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password_or_email_password

# ===========================================
# DEVELOPMENT & SEEDING
# ===========================================
# Database Seeding (set to true to seed database with sample data)
SEED_DATABASE=false

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================
# Socket.IO Configuration (uses same CORS as main app)
# Rate Limiting (handled by express-rate-limit)
# File Upload Limits (configured in multer middleware)

# ===========================================
# PRODUCTION NOTES
# ===========================================
# For production deployment:
# 1. Set NODE_ENV=production
# 2. Use strong, unique JWT_SECRET
# 3. Configure proper CORS origins
# 4. Use environment-specific database URLs
# 5. Enable HTTPS
# 6. Configure proper AWS IAM roles
# 7. Use secure email credentials
# 8. Set up proper logging and monitoring
